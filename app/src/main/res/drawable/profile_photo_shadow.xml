<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer shadow layer -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1a000000" />
        </shape>
    </item>
    <!-- Inner shadow highlight -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#08000000" />
        </shape>
    </item>
</layer-list>



