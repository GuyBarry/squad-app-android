<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_game_controller"
            android:contentDescription="@string/game_controller"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sign"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/up"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

    </LinearLayout>

    <EditText
        android:id="@+id/signup_username"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:autofillHints=""
        android:hint="@string/username"
        android:inputType="text"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edit_text_background" />

    <EditText
        android:id="@+id/signup_email"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:hint="@string/email"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edit_text_background" />

    <EditText
        android:id="@+id/signup_discord_tag"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:hint="@string/discord_tag"
        android:importantForAutofill="no"
        android:inputType="text"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edit_text_background" />

    <EditText
        android:id="@+id/signup_password"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:hint="@string/password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edit_text_background" />

    <EditText
        android:id="@+id/signup_confirm_password"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:hint="@string/confirm_password"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:padding="12dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/edit_text_background" />

    <Button
        android:id="@+id/signup_button"
        android:layout_width="300dp"
        android:layout_height="48dp"
        android:text="@string/sign_up"
        android:textSize="16sp"
        android:textColor="@color/button_text_color"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_background" />

    <TextView
        android:id="@+id/signup_signin_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/already_have_an_account_sign_in_here"
        android:textSize="14sp"
        android:textColor="@color/grey"
        android:layout_marginTop="16dp"
        android:padding="8dp" />

</LinearLayout>



